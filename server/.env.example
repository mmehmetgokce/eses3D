# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas bağlantı URI'nizi buraya yazın)
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/eses3d

# JWT Secret (güçlü bir anahtar oluşturun)
JWT_SECRET=buraya_gizli_anahtar_yazin

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp
WHATSAPP_NUMBER=905XXXXXXXXX

# Frontend URL (for CORS - deploy sonrası güncelleyin)
CLIENT_URL=http://localhost:5173